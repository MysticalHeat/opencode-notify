# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
PUBLIC_BASE_URL=https://relay.example.com

# Database
DATABASE_PATH=/data/opencode-notify.db

# Telegram (long-polling mode — required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Logging (optional, defaults to "info")
# LOGGING_LEVEL=debug

# ── Webhook (future) ──────────────────────────────────────
# Uncomment and configure to switch from long-polling to webhook.
# See docs/operations.md for the migration procedure.
#
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=
